    {
      "index": 9,
      "name": "Tanıtım Modülü",
      "path": "module-tanitim-3",
      "local": "body",
      "category": "module",
      "id": "xtzaiv",
      "desing": {
        "name": {
          "tr": "A.A. ROOTS'u Tanıyın",
          "en": "Get to Know A.A. ROOTS",
          "ar": "تعرف على A.A. ROOTS",
          "ru": "Узнайте A.A. ROOTS"
        },
        "spot": {
          "tr": "A.A. ROOTS İnşaat olarak Bodrum ve Türkiye genelinde villa, konut, ticari yapı ve renovasyon projelerinde güvenilir, dayanıklı ve estetik yaşam alanları sunuyoruz. Deneyimli kadromuz ve modern mimari anlayışımızla her projeyi titizlikle hayata geçiriyor; müşteri memnuniyetini ve kalıcı değeri ön planda tutuyoruz.",
          "en": "As A.A. ROOTS Construction we deliver reliable, durable and aesthetic living spaces in Bodrum and across Turkey—from villas and residential to commercial and renovation projects. With our experienced team and modern architectural approach we bring every project to life with care, putting client satisfaction and lasting value first.",
          "ar": "بصفتنا A.A. ROOTS للإنشاءات نقدم في بودروم وتركيا مساحات معيشة موثوقة ومتينة وجمالية: فيلات، سكني، تجاري وتجديد. بفريقنا ذي الخبرة ونهجنا المعماري الحديث ننفذ كل مشروع بعناية، مع أولوية رضا العميل والقيمة الدائمة.",
          "ru": "Как A.A. ROOTS Строительство мы создаём надёжные, долговечные и эстетичные жилые пространства в Бодруме и по всей Турции: виллы, жильё, коммерция и реновация. Опытная команда и современный архитектурный подход позволяют воплощать каждый проект с заботой о качестве и долгосрочной ценности."
        },
        "name2": {
          "tr": "Vizyonumuz",
          "en": "Our Vision",
          "ar": "رؤيتنا",
          "ru": "Наше видение"
        },
        "spot2": {
          "tr": "İnşaat ve yaşam alanları alanında sürdürülebilir, yenilikçi ve örnek projelerle sektörde fark yaratmak ve markamızdan söz ettirmek.",
          "en": "To stand out in construction and living spaces through sustainable, innovative and exemplary projects that make our name synonymous with quality.",
          "ar": "التميز في مجال البناء ومساحات العيش عبر مشاريع مستدامة ومبتكرة ومثالية تجعل اسمنا مرادفاً للجودة.",
          "ru": "Выделяться в сфере строительства и жилых пространств за счёт устойчивых, инновационных и образцовых проектов, делающих наше имя синонимом качества."
        },
        "icon2": "home",
        "name3": {
          "tr": "Misyonumuz",
          "en": "Our Mission",
          "ar": "مهمتنا",
          "ru": "Наша миссия"
        },
        "spot3": {
          "tr": "Müşterilerimizin hayallerindeki yaşam alanını, kaliteli malzeme, zamanında teslimat ve şeffaf iş birliğiyle gerçeğe dönüştürmek.",
          "en": "To turn our clients' dream spaces into reality through quality materials, on-time delivery and transparent collaboration.",
          "ar": "تحويل مساحات أحلام عملائنا إلى واقع من خلال مواد عالية الجودة والتسليم في الوقت المحدد والتعاون الشفاف.",
          "ru": "Воплощать мечты клиентов о жилье в реальность благодаря качественным материалам, сдаче в срок и прозрачному сотрудничеству."
        },
